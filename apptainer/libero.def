Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

# =============================================================================
# 原生 Apptainer 构建（无需 Docker），与 docker/Dockerfile 对齐。
# Python3.8(uv)；源码（含 bddl_files/init_files/assets 众多小文件）烤入镜像 →
# 集群上不 bind 源码，只在运行时按需 bind 演示数据集到 /workspace/libero/datasets。
#
# 构建（在 LIBERO 仓库根目录执行；输出到仓库外，避免 %files 把 .sif 自拷贝）：
#   apptainer build --fakeroot $WORK/sif/libero.sif apptainer/libero.def
#
# 无外网的计算节点需设代理（FAU NHR HPC3）：
#   export http_proxy=http://proxy:80 https_proxy=http://proxy:80
#   export APPTAINERENV_http_proxy=$http_proxy APPTAINERENV_https_proxy=$https_proxy
#
# 无 subuid 映射的集群，--fakeroot 无法伪造 dpkg postinst 的 chown，apt 会失败 →
# 需用 proot 构建（见 apptainer/README.md）或由管理员配置 /etc/subuid。
# =============================================================================

%files
    # 整仓库烤入（含 libero 包内 bddl_files/init_files/assets）；路径相对于 build 时的 cwd（仓库根）。
    . /workspace/libero

%labels
    Author VLA_Dev
    Version 1.0
    Description LIBERO sim client (uv, Python 3.8, aligned with docker/Dockerfile)

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH="/opt/venv/bin:/usr/local/bin:/root/.local/bin:/usr/bin:/bin"
    export VIRTUAL_ENV="/opt/venv"
    export HOME=/root
    export HF_HOME=/root/.cache/huggingface
    # libero 从 LIBERO_CONFIG_PATH 读 config.yaml；entrypoint 把它写到 /workspace/.libero，
    # 显式对齐，否则 import libero 触发交互式数据集路径提问(EOFError)。
    export LIBERO_CONFIG_PATH=/workspace/.libero
    # headless EGL 离屏渲染（run_eval 默认；run_eval.sh 运行时会覆盖为 osmesa）。
    export MUJOCO_GL=egl

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # 1. System dependencies（与 docker/Dockerfile 一致）
    # 无特权构建：禁止 apt 降权到 _apt 用户（单 UID namespace 下 setgroups/seteuid 会失败）。
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/00no-sandbox
    apt-get update -y
    apt-get install -y \
        curl wget tar procps bzip2 ca-certificates git build-essential cmake unzip tmux \
        ffmpeg libgl1-mesa-glx libglib2.0-0 \
        libegl1 libosmesa6 libgl1
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # 2. uv（与 docker/Dockerfile 一致）
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:${PATH}"
    # bind /root 时 /root/.local/bin 会被遮住 → 复制 uv 到固定 PATH 位置。
    cp /root/.local/bin/uv /usr/local/bin/uv && chmod +x /usr/local/bin/uv

    # 3. Python 3.8 venv（复制解释器到 /opt/python38 并重链，脱离 /root 依赖）
    uv venv --python 3.8 /opt/venv
    export PATH="/opt/venv/bin:${PATH}"
    export VIRTUAL_ENV="/opt/venv"
    _uv_py=$(find /root/.local/share/uv/python -maxdepth 3 -name 'python3.8' -type f 2>/dev/null | head -1)
    if [ -n "$_uv_py" ]; then
        _uv_dir=$(dirname "$(dirname "$_uv_py")")
        cp -a "$_uv_dir" /opt/python38
        ln -sf /opt/python38/bin/python3.8 /opt/venv/bin/python
        ln -sf /opt/python38/bin/python3.8 /opt/venv/bin/python3
        ln -sf /opt/python38/bin/python3.8 /opt/venv/bin/python3.8
    fi

    # 4. 锁定依赖栈（与 docker/Dockerfile 一致：先钉 setuptools，再 uv sync 到 active venv）
    cd /workspace/libero
    uv pip install --no-deps 'setuptools>=62.3,<81' --index-strategy unsafe-best-match
    uv sync --frozen --no-install-project --active

    # 5. libero editable（与 docker/Dockerfile 一致）
    cd /workspace/libero
    uv pip install -e . --index-strategy unsafe-best-match

    # 6. 运行时入口（entrypoint 负责 editable 重装 + 生成 /workspace/.libero/config.yaml）
    cp /workspace/libero/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
    chmod +x /usr/local/bin/entrypoint.sh

    mkdir -p /workspace/.libero /workspace/libero/datasets /root/.cache/huggingface

%runscript
    export PATH="/opt/venv/bin:/usr/local/bin:/root/.local/bin:${PATH:-/usr/bin:/bin}"
    export VIRTUAL_ENV="/opt/venv"
    if [ "$#" -eq 0 ]; then
        set -- /bin/bash
    fi
    exec /usr/local/bin/entrypoint.sh "$@"

%help
    原生 Apptainer 构建（无需 Docker），与 docker/Dockerfile 对齐。
    Python3.8(uv)；源码烤入；LIBERO_CONFIG_PATH=/workspace/.libero。
    构建：apptainer build --fakeroot <out>/libero.sif apptainer/libero.def
    运行：见 apptainer/run_eval.sh（--writable-tmpfs, MUJOCO_GL=osmesa, --log_dir /tmp/...）。
